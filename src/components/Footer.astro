---
import { site } from '../site.config';
import { url } from '../lib/content';
---

<footer class="no-print mt-28 border-t border-line">
  <div class="container-page py-16 sm:py-24">
    <p class="label">Contact</p>
    <h2 class="display mt-4 font-serif text-[clamp(2.5rem,7vw,5rem)] leading-none tracking-tight">
      Let’s <em>talk</em>.
    </h2>
    <a href={`mailto:${site.email}`} class="link mt-6 inline-block text-lg sm:text-xl">{site.email}</a>

    <div class="mt-16 flex flex-wrap items-center justify-between gap-4 text-sm text-muted">
      <p>© {new Date().getFullYear()} {site.name}</p>
      <ul class="flex flex-wrap gap-5">
        {
          site.social.map((item) => (
            <li>
              <a href={item.href} class="transition-colors hover:text-fg" rel="me noopener">
                {item.label}
              </a>
            </li>
          ))
        }
        <li><a href={url('/rss.xml')} class="transition-colors hover:text-fg">RSS</a></li>
      </ul>
    </div>
  </div>
</footer>
