---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getWriting, formatDate, url } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getWriting();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description} type="article" image={`/og/writing/${post.id}.png`}>
  <article class="container-page pt-16 sm:pt-24">
    <a href={url('/portfolio/')} class="label link">← Portfolio</a>
    <h1 class="mt-6 max-w-3xl font-serif text-[clamp(2.5rem,6vw,4.5rem)] leading-[1.02] tracking-tight">
      {post.data.title}
    </h1>
    <p class="label mt-6 flex flex-wrap gap-x-4 gap-y-1">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      {post.data.tags.map((tag) => <span>#{tag}</span>)}
    </p>
    <div class="prose mt-12">
      <Content />
    </div>
  </article>
</Base>
