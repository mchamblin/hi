---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getWriting, formatDate, url } from '../../lib/content';

const posts = await getWriting();
---

<Base title="Writing" description="Notes on building software and working with teams.">
  <PageHeader label="Writing" title="Notes &amp; <em>essays</em>." lede="Things I’ve learned, mostly the hard way." />
  <div class="container-page">
    <ul class="border-b border-line">
      {
        posts.map((post) => (
          <li class="reveal border-t border-line">
            <a href={url(`/writing/${post.id}/`)} class="group grid gap-2 py-7 sm:grid-cols-[9rem_1fr]">
              <time class="label pt-1.5" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
              <div>
                <h2 class="font-serif text-3xl leading-tight tracking-tight transition-colors group-hover:text-accent">
                  {post.data.title}
                </h2>
                <p class="mt-2 max-w-xl text-muted">{post.data.description}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
