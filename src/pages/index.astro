---
import Base from '../layouts/Base.astro';
import WorkRow from '../components/WorkRow.astro';
import { site, experience, stats, shippedFor } from '../site.config';
import { getWork, getWriting, formatDate, url } from '../lib/content';

const work = (await getWork()).filter((entry) => entry.data.featured);
const posts = (await getWriting()).slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  sameAs: site.social.map((item) => item.href),
};
---

<Base>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <section class="hero relative">
   <div class="container-page pb-16 pt-14 sm:pb-20 sm:pt-24">
    {
      site.available && (
        <p class="rise label inline-flex items-center gap-2.5 rounded-full border border-line bg-bg px-3 py-1.5">
          <span class="size-2 rounded-full bg-emerald-500 motion-safe:animate-[pulse-dot_2s_ease-in-out_infinite]" />
          {site.availableLabel}
        </p>
      )
    }
    <h1
      class="rise display mt-8 font-serif text-[clamp(2.75rem,7.4vw,6.25rem)] leading-[0.96] tracking-tight"
      style="--i:1"
      set:html={site.headline}
    />
    <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_22rem] lg:gap-20">
      <div class="rise" style="--i:2">
        <p class="max-w-xl text-xl leading-relaxed">{site.intro}</p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={url('/work/')} class="btn btn-primary">See my work <span aria-hidden="true">→</span></a>
          <a href={url('/resume/')} class="btn btn-ghost">Résumé</a>
          <a href={`mailto:${site.email}`} class="link ml-2 text-sm text-muted">{site.email}</a>
        </div>
      </div>
      <dl class="rise self-end text-sm" style="--i:3">
        {
          site.glance.map((item) => (
            <div class="grid grid-cols-[5.5rem_1fr] gap-4 border-t border-line py-3">
              <dt class="label pt-0.5">{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
   </div>
  </section>

  <section class="container-page mb-24" aria-label="Career in numbers">
    <dl class="grid grid-cols-2 border-y border-line lg:grid-cols-4">
      {
        stats.map((stat) => (
          <div class="stat reveal flex flex-col-reverse justify-end py-7 pr-6 lg:py-9">
            <dt class="mt-2 max-w-[14rem] text-sm leading-snug text-muted">{stat.label}</dt>
            <dd class="font-serif text-[clamp(2.75rem,5.5vw,4.5rem)] leading-none tracking-tight">{stat.value}</dd>
          </div>
        ))
      }
    </dl>
    <div class="reveal flex flex-wrap items-baseline gap-x-8 gap-y-3 border-b border-line py-6">
      <p class="label">Shipped for</p>
      <ul class="flex flex-wrap gap-x-8 gap-y-2 font-serif text-2xl tracking-tight sm:text-3xl">
        {shippedFor.map((name) => <li>{name}</li>)}
      </ul>
    </div>
  </section>

  <section class="container-page" aria-labelledby="work-heading">
    <div class="flex items-baseline justify-between pb-6">
      <h2 id="work-heading" class="label">Selected work</h2>
      <a href={url('/work/')} class="label link">All projects</a>
    </div>
    <div class="border-b border-line">
      {work.map((entry, index) => <WorkRow entry={entry} index={index} />)}
    </div>
  </section>

  <section class="container-page mt-28 grid gap-10 lg:grid-cols-[14rem_1fr]" aria-labelledby="exp-heading">
    <div>
      <h2 id="exp-heading" class="label">Experience</h2>
    </div>
    <div>
      <ol>
        {
          experience.map((job) => (
            <li class="reveal grid gap-1 border-t border-line py-5 sm:grid-cols-[1fr_auto] sm:gap-6">
              <div>
                <p class="text-lg font-medium">{job.title}</p>
                <p class="text-muted">{job.company}</p>
              </div>
              {job.start && (
                <p class="label sm:pt-1.5">
                  {job.start} – {job.end}
                </p>
              )}
            </li>
          ))
        }
      </ol>
      <a href={url('/resume/')} class="link mt-6 inline-block">Full résumé →</a>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="container-page mt-28 grid gap-10 lg:grid-cols-[14rem_1fr]" aria-labelledby="writing-heading">
        <div>
          <h2 id="writing-heading" class="label">
            Writing
          </h2>
        </div>
        <div>
          <ul>
            {posts.map((post) => (
              <li class="reveal border-t border-line">
                <a href={url(`/writing/${post.id}/`)} class="group grid gap-1 py-5 sm:grid-cols-[1fr_auto] sm:gap-6">
                  <div>
                    <p class="text-lg font-medium transition-colors group-hover:text-accent">{post.data.title}</p>
                    <p class="text-muted">{post.data.description}</p>
                  </div>
                  <time class="label sm:pt-1.5" datetime={post.data.date.toISOString()}>
                    {formatDate(post.data.date)}
                  </time>
                </a>
              </li>
            ))}
          </ul>
          <a href={url('/writing/')} class="link mt-6 inline-block">
            All writing →
          </a>
        </div>
      </section>
    )
  }
</Base>
