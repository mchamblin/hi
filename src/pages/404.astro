---
import Base from '../layouts/Base.astro';
import { url } from '../lib/content';
---

<Base title="Not found" noindex>
  <div class="container-page py-32 text-center">
    <p class="label">404</p>
    <h1 class="display mt-4 font-serif text-[clamp(3rem,9vw,6rem)] leading-none tracking-tight">
      Nothing <em>here</em>.
    </h1>
    <a href={url('/')} class="btn btn-primary mt-10">Back home</a>
  </div>
</Base>
