---
import Base from '../layouts/Base.astro';
import { site, experience, education, skills } from '../site.config';
---

<Base title="Résumé" description={`Résumé of ${site.name}, ${site.role}.`}>
  <div class="container-page max-w-4xl! pt-16 sm:pt-24 print:pt-0">
    <header class="flex flex-wrap items-end justify-between gap-6 border-b border-fg pb-8">
      <div>
        <h1 class="font-serif text-6xl leading-none tracking-tight print:text-4xl">{site.name}</h1>
        <p class="mt-3 text-lg text-muted">{site.role} · {site.location}</p>
        <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
          <a href={`mailto:${site.email}`} class="link">{site.email}</a>
          {site.social.map((item) => <a href={item.href} class="link">{item.href.replace(/^https?:\/\/(www\.)?/, '')}</a>)}
        </p>
      </div>
      <button type="button" class="btn btn-primary no-print cursor-pointer" onclick="window.print()">
        Save as PDF
      </button>
    </header>

    <section class="mt-10">
      <h2 class="label">Experience</h2>
      {
        experience.map((job) => (
          <div class="mt-5 grid gap-x-8 gap-y-1 border-t border-line pt-5 sm:grid-cols-[8rem_1fr] print:grid-cols-[8rem_1fr] print:break-inside-avoid">
            <p class="label pt-1">
              {job.start} – {job.end}
            </p>
            <div>
              <h3 class="text-lg font-semibold">
                {job.title}, <span class="font-normal">{job.company}</span>
              </h3>
              {job.summary && <p class="mt-1 text-muted">{job.summary}</p>}
              <ul class="mt-3 list-disc space-y-1.5 pl-5 marker:text-muted">
                {job.highlights.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </section>

    <section class="mt-12 print:break-inside-avoid">
      <h2 class="label">Skills</h2>
      <dl class="mt-5 border-t border-line">
        {
          skills.map((group) => (
            <div class="grid gap-x-8 border-b border-line py-3 sm:grid-cols-[8rem_1fr] print:grid-cols-[8rem_1fr]">
              <dt class="label pt-1">{group.group}</dt>
              <dd>{group.items.join(' · ')}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-12 print:break-inside-avoid">
      <h2 class="label">Education</h2>
      {
        education.map((item) => (
          <div class="mt-5 grid gap-x-8 border-t border-line pt-5 sm:grid-cols-[8rem_1fr] print:grid-cols-[8rem_1fr]">
            <p class="label pt-1">{item.year}</p>
            <p>
              <span class="font-semibold">{item.credential}</span>, {item.school}
            </p>
          </div>
        ))
      }
    </section>
  </div>
</Base>
